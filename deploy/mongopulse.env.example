# mongopulse configuration
# Copy to /etc/mongopulse/mongopulse.env and set MONGO_DSN

# Required: MongoDB connection URI (comma-separated for multi-target)
MONGO_DSN=mongodb://mongopulse:password@localhost:27017

# Port for Prometheus /metrics endpoint
METRICS_PORT=9216

# How often to poll MongoDB for metrics
POLL_INTERVAL=5s

# Queries slower than this are counted as slow
SLOW_QUERY_THRESHOLD=5s

# Multiplier over baseline mean to flag query regression
REGRESSION_THRESHOLD=2.0

# Max profiler entries to process per poll
STMT_LIMIT=50

# Telegram bot token for alerts (optional)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Slack/generic webhook URL for alerts (optional)
# ALERT_WEBHOOK_URL=

# Minimum interval between repeated alerts of same type
ALERT_COOLDOWN=5m

# Grafana base URL for anomaly annotations (optional)
# GRAFANA_URL=
# GRAFANA_TOKEN=
# GRAFANA_DASHBOARD_UID=
